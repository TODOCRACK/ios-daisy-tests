+/* Escritura opt-in del brillo del WLED (daisywledw=1, requiere daisywled=1). Un solo intento por arranque. */
+#define WLED_ARB_CHNLS      0x02400000u
+#define WLED_CMD            0x00u
+#define WLED_STATUS         0x08u
+#define WLED_WDATA0         0x10u
+#define WLED_OP_EXT_WRITEL  0u
+
+static int
+daisy_wled_write(uint16_t ppid, uint8_t reg, uint8_t val)
+{
+	uint16_t apid;
+	vm_offset_t chan;
+	int r = -100;
+
+	if (!spmi_core || !spmi_cnfg) {
+		return -1;
+	}
+	apid = spmi_find_apid(ppid);
+	if (apid == NO_APID) {
+		return -2;
+	}
+	if ((in_rd(spmi_cnfg, 0x700u + 4u * apid) & 7u) != 0) {
+		return -3;  /* el propietario no es el procesador de aplicaciones */
+	}
+	chan = ml_io_map(WLED_ARB_CHNLS + 0x8000u * apid, 0x1000);
+	if (!chan) {
+		return -4;
+	}
+	*(volatile uint32_t *)(chan + WLED_WDATA0) = val;
+	*(volatile uint32_t *)(chan + WLED_CMD) = (WLED_OP_EXT_WRITEL << 27) | ((uint32_t)reg << 4);
+	for (unsigned k = 0; k < 10000; k++) {
+		uint32_t st = *(volatile uint32_t *)(chan + WLED_STATUS);
+
+		if (st & 0xE) {
+			r = -(int)st;
+			break;
+		}
+		if (st & 1) {
+			r = 0;
+			break;
+		}
+		in_sleep(&touch_chan, 1);
+	}
+	return r;
+}
